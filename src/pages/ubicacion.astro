---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout currentPath="/ubicacion">
  <section class="hero-section relative min-h-[55vh] flex items-center bg-gradient-to-br from-primary-dark via-primary to-primary-dark overflow-hidden">
    <div class="hero-bg-image hero-bg-visible" style="background-image: url('https://images.pexels.com/photos/1181263/pexels-photo-1181263.jpeg?auto=compress&cs=tinysrgb&w=1920')"></div>
    <div class="hero-pattern"></div>
    <div class="floating-shape floating-shape-1"></div>
    <div class="floating-shape floating-shape-2"></div>

    <!-- Logo watermark decorativo -->
    <div class="absolute right-0 top-1/2 -translate-y-1/2 z-[1] w-[28vw] h-[28vw] max-w-[400px] max-h-[400px] pointer-events-none select-none hidden lg:flex items-center justify-center opacity-[0.06]">
      <img src="/logo%20notaria%2080%20verde.png" alt="" class="w-full h-full object-contain" aria-hidden="true">
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-16">
      <div class="max-w-3xl">
        <div class="reveal mb-8">
          <span class="inline-flex items-center gap-2.5 glass rounded-full px-5 py-2 text-cream text-sm font-medium tracking-[0.15em] uppercase">
            <i class="fas fa-map-marker-alt text-cream/70 text-xs"></i>
            Estamos para servirle
          </span>
        </div>

        <h1 class="font-display text-cream reveal" style="transition-delay: 0.1s;">
          <span class="block text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold leading-[1.04] tracking-tight drop-shadow-xl">
            Contacto
          </span>
          <span class="block text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-light italic mt-2 text-cream/85 drop-shadow-lg">
            y ubicación
          </span>
        </h1>

        <div class="flex items-center gap-4 my-8 reveal" style="transition-delay: 0.15s;">
          <span class="block w-12 h-px bg-cream/20"></span>
          <span class="block w-1.5 h-1.5 rounded-full bg-primary-light/50"></span>
          <span class="block flex-1 h-px bg-cream/10"></span>
        </div>

        <p class="text-base sm:text-lg text-cream/55 max-w-xl leading-relaxed reveal" style="transition-delay: 0.2s;">
          Contáctanos para agendar una cita o resolver tus dudas.
        </p>
      </div>
    </div>
  </section>

  <!-- ── MAPA + TARJETA FLOTANTE ── -->
  <section class="relative mt-12 z-20 pb-8">
    <div class="max-w-7xl mx-auto px-4">
      <div class="reveal">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/20">
          <div class="relative w-full" style="aspect-ratio: 16/9; min-height: 320px;">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3732.671578984743!2d-103.37240838455547!3d20.684350086192958!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8428b1e9b9b9b9b9%3A0x1234567890abcdef!2sC.%20Pablo%20Villase%C3%B1or%20125%2C%20Ladr%C3%B3n%20de%20Guevara%2C%2044650%20Guadalajara%2C%20Jal.%2C%20Mexico!5e0!3m2!1ses!2smx!4v1673567890123!5m2!1ses!2smx"
              class="absolute inset-0 w-full h-full"
              style="border: 0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación de Notaría Pública #80">
            </iframe>
          </div>

          <!-- Tarjeta flotante con dirección -->
          <div class="absolute bottom-6 left-6 right-6 md:left-auto md:right-6 md:w-80 bg-cream/90 backdrop-blur-md rounded-2xl p-5 shadow-xl border border-primary/5">
            <div class="flex items-start gap-3">
              <div class="w-11 h-11 bg-primary rounded-xl flex items-center justify-center text-cream flex-shrink-0 mt-0.5">
                <i class="fas fa-map-pin"></i>
              </div>
              <div>
                <p class="font-display font-bold text-primary text-sm">Notaría Pública #80</p>
                <p class="text-xs text-gray-600 mt-0.5 leading-relaxed">
                  C. Pablo Villaseñor 125, Ladrón de Guevara<br>
                  44600 Guadalajara, Jal.
                </p>
                <a href="https://maps.app.goo.gl/r7m3GeXd8C3n8Gq27" target="_blank" class="inline-flex items-center gap-1 text-xs font-semibold text-primary-light hover:text-primary mt-2 transition-colors">
                  <i class="fas fa-external-link-alt text-[10px]"></i> Abrir en Google Maps
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── BOTONES DE ACCIÓN RÁPIDA ── -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 reveal">
        <a href="https://maps.app.goo.gl/r7m3GeXd8C3n8Gq27" target="_blank" class="group bg-cream rounded-2xl p-5 flex items-center gap-4 shadow-md hover:shadow-xl transition-all hover:-translate-y-1 border border-primary/5">
          <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary text-xl group-hover:bg-primary group-hover:text-white transition-all">
            <i class="fas fa-map-marked-alt"></i>
          </div>
          <div>
            <p class="font-semibold text-primary text-sm">Google Maps</p>
            <p class="text-xs text-gray-500">Ver ubicación exacta</p>
          </div>
        </a>
        <a href="tel:+523319833354" class="group bg-cream rounded-2xl p-5 flex items-center gap-4 shadow-md hover:shadow-xl transition-all hover:-translate-y-1 border border-primary/5">
          <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary text-xl group-hover:bg-primary group-hover:text-white transition-all">
            <i class="fas fa-phone-alt"></i>
          </div>
          <div>
            <p class="font-semibold text-primary text-sm">Llamar Ahora</p>
            <p class="text-xs text-gray-500">33 1983 3354</p>
          </div>
        </a>
        <a href="https://wa.me/523311704104" target="_blank" class="group bg-cream rounded-2xl p-5 flex items-center gap-4 shadow-md hover:shadow-xl transition-all hover:-translate-y-1 border border-primary/5">
          <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary text-xl group-hover:bg-primary group-hover:text-white transition-all">
            <i class="fab fa-whatsapp"></i>
          </div>
          <div>
            <p class="font-semibold text-primary text-sm">WhatsApp</p>
            <p class="text-xs text-gray-500">Horario laboral L-V 9:00 AM – 5:00 PM</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ── CARDS DE INFORMACIÓN ── -->
  <section class="py-12 lg:py-16 bg-gradient-to-br from-primary via-primary-dark to-primary relative overflow-hidden">
    <div class="hero-bg-image hero-bg-visible" style="background-image: url('https://images.pexels.com/photos/5668858/pexels-photo-5668858.jpeg?auto=compress&cs=tinysrgb&w=1920')"></div>
    <div class="hero-pattern"></div>
    <div class="floating-shape floating-shape-3 opacity-20" style="top: 10%; right: 5%;"></div>
    <div class="max-w-7xl mx-auto px-4 relative z-10">
      <div class="text-center mb-12 reveal">
        <span class="text-primary-light text-sm font-semibold tracking-[0.2em] uppercase mb-3 block">Información de Contacto</span>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-cream">Estamos a tu servicio</h2>
        <p class="text-cream/55 text-sm sm:text-base max-w-md mx-auto leading-relaxed mt-3">Todos los canales disponibles para atenderte con la calidad y profesionalismo que nos caracteriza</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 stagger-children">
        <!-- Teléfono -->
        <div class="contact-card">
          <div class="contact-card-icon gradient-green">
            <i class="fas fa-phone-alt"></i>
          </div>
          <h3 class="font-display font-bold text-primary mb-3">Teléfonos</h3>
          <div class="space-y-1.5">
            <a href="tel:+523319833354" class="block text-gray-600 hover:text-primary transition-colors text-sm font-medium">33 1983 3354</a>
            <a href="tel:+523319833355" class="block text-gray-600 hover:text-primary transition-colors text-sm font-medium">33 1983 3355</a>
            <a href="tel:+523336306433" class="block text-gray-600 hover:text-primary transition-colors text-sm font-medium">33 3630 6433</a>
          </div>
          <a href="tel:+523319833354" class="contact-card-action">
            <i class="fas fa-phone"></i> Llamar ahora
          </a>
        </div>

        <!-- Correo -->
        <div class="contact-card">
          <div class="contact-card-icon gradient-green">
            <i class="fas fa-envelope"></i>
          </div>
          <h3 class="font-display font-bold text-primary mb-3">Correo Electrónico</h3>
          <a href="mailto:notaria80gdl@hotmail.com" class="block text-gray-600 hover:text-primary transition-colors text-sm font-medium break-all">notaria80gdl@hotmail.com</a>
          <a href="mailto:notaria80gdl@hotmail.com" class="contact-card-action">
            <i class="fas fa-envelope"></i> Enviar correo
          </a>
        </div>

        <!-- Ubicación -->
        <div class="contact-card">
          <div class="contact-card-icon gradient-green">
            <i class="fas fa-map-marker-alt"></i>
          </div>
          <h3 class="font-display font-bold text-primary mb-3">Ubicación</h3>
          <a href="https://maps.app.goo.gl/twQxYo9FdYSYLmEw9" target="_blank" class="block text-gray-600 hover:text-primary transition-colors text-sm font-medium leading-relaxed">
            C. Pablo Villaseñor 125<br>
            Ladrón de Guevara, 44600<br>
            Guadalajara, Jal.
          </a>
          <a href="https://maps.app.goo.gl/twQxYo9FdYSYLmEw9" target="_blank" class="contact-card-action">
            <i class="fas fa-map-marked-alt"></i> Ver en mapa
          </a>
        </div>

        <!-- Horarios -->
        <div class="contact-card">
          <div class="contact-card-icon gradient-green">
            <i class="fas fa-clock"></i>
          </div>
          <h3 class="font-display font-bold text-primary mb-3">Horarios</h3>
          <p class="text-gray-600 text-sm font-medium">Lunes a Viernes</p>
          <p class="text-gray-500 text-sm">9:00 AM – 5:00 PM</p>
          <div class="mt-3 flex items-center gap-2 text-xs font-medium text-primary-light">
            <span class="w-2 h-2 bg-green-500 rounded-full inline-block animate-pulse"></span>
            Abierto ahora
          </div>
          <div class="contact-card-action cursor-default opacity-50">
            <i class="fas fa-clock"></i> Horario laboral
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WHATSAPP BANNER ── -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4">
      <div class="reveal relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary to-primary-dark p-8 md:p-12 shadow-2xl">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>
        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-5">
            <div class="w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center text-3xl text-white">
              <i class="fab fa-whatsapp"></i>
            </div>
            <div>
              <h3 class="font-display text-2xl font-bold text-cream">¿Necesitas atención?</h3>
              <p class="text-cream/80 text-sm mt-1">Escríbenos por WhatsApp en horario laboral y te atenderemos a la brevedad</p>
            </div>
          </div>
          <a href="https://wa.me/523311704104" target="_blank" class="flex-shrink-0 bg-cream text-primary px-8 py-4 rounded-2xl font-bold text-lg flex items-center gap-3 hover:bg-cream-dark transition-all shadow-xl hover:shadow-2xl hover:-translate-y-1">
            <i class="fab fa-whatsapp text-2xl"></i> Iniciar Chat
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FORMULARIO DE CONTACTO ── -->
  <section class="py-12 lg:py-16 bg-gradient-to-b from-cream to-cream-dark/30">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid lg:grid-cols-5 gap-10 items-start">
        <!-- Info lateral -->
        <div class="lg:col-span-2 reveal-left lg:sticky lg:top-28">
          <span class="text-primary-light text-sm font-semibold tracking-[0.2em] uppercase mb-3 block">Formulario</span>
          <h2 class="font-display text-4xl md:text-5xl font-bold text-primary mb-4">Envíanos un mensaje</h2>
          <p class="text-gray-600 text-sm sm:text-base leading-relaxed mb-8">
            Déjanos tus datos y te contactaremos a la brevedad para atender tu solicitud. Todos los campos marcados con <span class="text-primary-light font-semibold">*</span> son obligatorios.
          </p>

          <div class="space-y-4">
            <div class="flex items-center gap-3 text-sm text-gray-500">
              <div class="w-9 h-9 bg-primary/8 rounded-lg flex items-center justify-center text-primary flex-shrink-0">
                <i class="fas fa-check-circle text-xs"></i>
              </div>
              <span>Respuesta en máximo 24 horas hábiles</span>
            </div>
            <div class="flex items-center gap-3 text-sm text-gray-500">
              <div class="w-9 h-9 bg-primary/8 rounded-lg flex items-center justify-center text-primary flex-shrink-0">
                <i class="fas fa-lock text-xs"></i>
              </div>
              <span>Tus datos están protegidos y son confidenciales</span>
            </div>
            <div class="flex items-center gap-3 text-sm text-gray-500">
              <div class="w-9 h-9 bg-primary/8 rounded-lg flex items-center justify-center text-primary flex-shrink-0">
                <i class="fas fa-headset text-xs"></i>
              </div>
              <span>Atención personalizada y profesional</span>
            </div>
          </div>
        </div>

        <!-- Formulario -->
        <div class="lg:col-span-3 reveal-right">
          <div class="glass-green rounded-3xl p-8 md:p-10 shadow-2xl">
            <form id="contact-form" class="space-y-5">
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="nombre" class="block text-sm font-semibold text-cream/80 mb-1.5">Nombre Completo <span class="text-primary-light">*</span></label>
                  <input type="text" id="nombre" name="nombre" required placeholder="Ej. Juan Pérez" class="form-input">
                </div>
                <div>
                  <label for="email" class="block text-sm font-semibold text-cream/80 mb-1.5">Correo Electrónico <span class="text-primary-light">*</span></label>
                  <input type="email" id="email" name="email" required placeholder="ejemplo@correo.com" class="form-input">
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="telefono" class="block text-sm font-semibold text-cream/80 mb-1.5">Teléfono</label>
                  <input type="tel" id="telefono" name="telefono" placeholder="33 1234 5678" class="form-input">
                </div>
                <div>
                  <label for="asunto" class="block text-sm font-semibold text-cream/80 mb-1.5">Asunto <span class="text-primary-light">*</span></label>
                  <select id="asunto" name="asunto" required class="form-input">
                    <option value="">Selecciona un asunto</option>
                    <option value="Compraventa de Inmuebles">Compraventa de Inmuebles</option>
                    <option value="Testamentos">Testamentos</option>
                    <option value="Constitución de Sociedades">Constitución de Sociedades</option>
                    <option value="Poderes Notariales">Poderes Notariales</option>
                    <option value="Certificaciones">Certificaciones</option>
                    <option value="Asesoría Legal">Asesoría Legal</option>
                    <option value="Otro">Otro</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="mensaje" class="block text-sm font-semibold text-cream/80 mb-1.5">Mensaje <span class="text-primary-light">*</span></label>
                <textarea id="mensaje" name="mensaje" rows="5" required placeholder="Describe tu consulta o solicitud..." class="form-input resize-y min-h-[130px]"></textarea>
              </div>

              <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 pt-2">
                <button type="submit" class="btn-primary px-8 py-4 rounded-2xl font-semibold text-lg flex items-center gap-3 shadow-lg w-full sm:w-auto justify-center">
                  <i class="fas fa-paper-plane"></i>
                  Enviar Mensaje
                </button>
                <p class="text-xs text-gray-400">
                  <i class="fas fa-shield-alt mr-1"></i>
                  No compartiremos tus datos personales
                </p>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>


</BaseLayout>
