---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout currentPath="/">

  <!-- ── HERO ── -->
  <section class="hero-section relative min-h-screen flex items-center bg-gradient-to-br from-primary-dark via-primary to-primary-dark">
    <!-- Crossfade background: 3 imágenes legales con transición suave -->
    <div class="hero-bg-crossfade" style="background-image: url('https://images.pexels.com/photos/5668858/pexels-photo-5668858.jpeg?auto=compress&cs=tinysrgb&w=1920')"></div>
    <div class="hero-bg-crossfade" style="background-image: url('https://images.pexels.com/photos/416320/pexels-photo-416320.jpeg?auto=compress&cs=tinysrgb&w=1920')"></div>
    <div class="hero-bg-crossfade" style="background-image: url('https://images.pexels.com/photos/1181406/pexels-photo-1181406.jpeg?auto=compress&cs=tinysrgb&w=1920')"></div>
    <div class="hero-pattern"></div>
    <div class="floating-shape floating-shape-1"></div>
    <div class="floating-shape floating-shape-2"></div>

    <!-- Logo watermark — esquina inferior derecha, completo, sin invadir el contenido -->
    <img src="/logo%20notaria%2080%20verde.png" alt=""
      class="absolute bottom-8 right-8 z-[5] w-[42vw] max-w-[520px] h-auto opacity-[0.10] lg:opacity-[0.08] pointer-events-none select-none brightness-0 invert"
      aria-hidden="true">

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-20">
      <div class="max-w-3xl">
        <!-- Badge -->
        <div class="reveal mb-10">
          <span class="inline-flex items-center gap-2.5 glass rounded-full px-5 py-2 text-cream text-sm font-medium tracking-[0.15em] uppercase">
            <i class="fas fa-gavel text-cream/70 text-xs"></i>
            Fe Pública · Seguridad Jurídica
          </span>
        </div>

        <!-- Main heading: editorial stacked layout -->
        <h1 class="font-display text-cream reveal" style="transition-delay: 0.1s;">
          <span class="block text-sm font-semibold text-cream/50 tracking-[0.3em] uppercase mb-6 font-body">Notaría Pública #80</span>
          <span class="block text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold leading-[1.04] tracking-tight drop-shadow-xl">
            Garantizamos
          </span>
          <span class="block text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-light italic mt-4 text-cream/85 drop-shadow-lg">
            seguridad jurídica
          </span>
          <span class="block text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-medium not-italic mt-2 text-cream drop-shadow-lg">
            e imparcialidad
          </span>
        </h1>

        <!-- Editorial divider -->
        <div class="flex items-center gap-4 my-10 reveal" style="transition-delay: 0.15s;">
          <span class="block w-12 h-px bg-cream/20"></span>
          <span class="block w-1.5 h-1.5 rounded-full bg-primary-light/50"></span>
          <span class="block flex-1 h-px bg-cream/10"></span>
        </div>

        <!-- Description -->
        <p class="text-base sm:text-lg text-cream/55 max-w-xl leading-relaxed reveal mb-12" style="transition-delay: 0.2s;">
          Brindamos servicios notariales profesionales con la más alta calidad y el compromiso de hacer la justicia accesible para todos.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 reveal" style="transition-delay: 0.3s;">
          <a href="servicios.html" class="btn-primary px-8 py-3.5 rounded-2xl font-semibold flex items-center justify-center gap-3 shadow-2xl shadow-black/20">
            <i class="fas fa-arrow-right"></i> Nuestros Servicios
          </a>
          <a href="https://wa.me/523311704104" target="_blank" class="glass px-8 py-3.5 rounded-2xl text-cream font-semibold flex items-center justify-center gap-3 hover:bg-cream/15 transition-all">
            <i class="fab fa-whatsapp"></i> Contactar por WhatsApp
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator removed per user request -->
  </section>


  <!-- ── MÉTRICAS DE CONFIANZA ── (nueva sección — overhaul T-018) -->
  <section class="py-16 lg:py-20 bg-primary-dark relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.pexels.com/photos/1181722/pexels-photo-1181722.jpeg?auto=compress&cs=tinysrgb&w=1920')] bg-cover bg-center opacity-20"></div>
    <div class="max-w-7xl mx-auto px-4 relative z-10">
      <div class="text-center mb-12 reveal">
        <span class="text-primary-light text-sm font-semibold tracking-[0.2em] uppercase mb-4 block">Cifras que respaldan</span>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-cream mb-6">Confianza construida con el tiempo</h2>
        <p class="text-cream/60 text-sm sm:text-base max-w-lg mx-auto leading-relaxed">Más de una década de servicio notarial en Guadalajara, con la certeza jurídica que tu patrimonio merece.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 stagger-children">
        <div class="stat-card bg-gradient-to-b from-primary-dark via-primary to-primary-dark rounded-3xl p-8 lg:p-10 text-center border border-cream/10 hover:border-cream/20 transition-all group hover:-translate-y-1">
          <div class="text-[6rem] lg:text-[8rem] font-display font-black text-cream/5 mb-4 select-none pointer-events-none">01</div>
          <div class="stat-number text-4xl lg:text-5xl font-bold text-cream mb-1 stat-counter" data-count="2013" data-duration="2000">0</div>
          <div class="text-cream/50 text-sm font-medium font-body tracking-wide uppercase">Desde el 1 de marzo</div>
        </div>
        <div class="stat-card bg-gradient-to-b from-primary-dark via-primary to-primary-dark rounded-3xl p-8 lg:p-10 text-center border border-cream/10 hover:border-cream/20 transition-all group hover:-translate-y-1">
          <div class="text-[6rem] lg:text-[8rem] font-display font-black text-cream/5 mb-4 select-none pointer-events-none">02</div>
          <div class="stat-number text-4xl lg:text-5xl font-bold text-cream mb-1 stat-counter" data-count="30" data-suffix="+" data-duration="2000">0</div>
          <div class="text-cream/50 text-sm font-medium font-body tracking-wide uppercase">Años de trayectoria jurídica</div>
        </div>
        <div class="stat-card bg-gradient-to-b from-primary-dark via-primary to-primary-dark rounded-3xl p-8 lg:p-10 text-center border border-cream/10 hover:border-cream/20 transition-all group hover:-translate-y-1">
          <div class="text-[6rem] lg:text-[8rem] font-display font-black text-cream/5 mb-4 select-none pointer-events-none">03</div>
          <div class="stat-number text-4xl lg:text-5xl font-bold text-cream mb-1 stat-counter" data-count="6" data-duration="2000">0</div>
          <div class="text-cream/50 text-sm font-medium font-body tracking-wide uppercase">Servicios especializados</div>
        </div>
        <div class="stat-card bg-gradient-to-b from-primary-dark via-primary to-primary-dark rounded-3xl p-8 lg:p-10 text-center border border-cream/10 hover:border-cream/20 transition-all group hover:-translate-y-1">
          <div class="text-[6rem] lg:text-[8rem] font-display font-black text-cream/5 mb-4 select-none pointer-events-none">04</div>
          <div class="text-4xl lg:text-5xl font-bold text-cream mb-1">44600</div>
          <div class="text-cream/50 text-sm font-medium font-body tracking-wide uppercase">Guadalajara, Jal.</div>
        </div>
      </div>
    </div>
  </section>


  <!-- ── SERVICIOS PREVIEW ── -->
  <section class="py-24 lg:py-32 bg-gradient-to-b from-cream to-cream-dark relative overflow-hidden">
    <!-- Decorative top line -->
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/10 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16 reveal">
        <span class="text-primary-light text-sm font-semibold tracking-[0.2em] uppercase mb-4 block">Nuestros Servicios</span>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-primary leading-tight mb-6">
          Soluciones notariales <span class="text-primary-light font-light italic">integrales</span>
        </h2>
        <p class="text-gray-500 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
          Cada trámite notarial merece certeza y profesionalismo. Te acompañamos paso a paso con soluciones integrales que garantizan seguridad jurídica y total tranquilidad.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 stagger-children">

        <!-- Servicio 1 -->
        <div class="service-card group relative overflow-hidden">
          <span class="absolute -top-4 -right-4 text-[8rem] font-display font-black text-cream/5 leading-none pointer-events-none select-none">01</span>
          <div class="relative z-10">
            <div class="service-card-icon mb-6">
              <i class="fas fa-home"></i>
            </div>
            <h3 class="font-display text-xl font-bold text-cream mb-3 group-hover:text-cream/80 transition-colors">Traslativos de Dominio</h3>
            <p class="text-cream/65 text-sm leading-relaxed mb-5">
              Escrituración de propiedades con total seguridad jurídica y transparencia.
            </p>
            <div class="flex flex-wrap gap-1.5">
              <span class="service-tag">Compraventa</span>
              <span class="service-tag">Donación</span>
              <span class="service-tag">Fideicomisos</span>
            </div>
          </div>
        </div>

        <!-- Servicio 2 -->
        <div class="service-card group relative overflow-hidden">
          <span class="absolute -top-4 -right-4 text-[8rem] font-display font-black text-cream/5 leading-none pointer-events-none select-none">02</span>
          <div class="relative z-10">
            <div class="service-card-icon mb-6">
              <i class="fas fa-scroll"></i>
            </div>
            <h3 class="font-display text-xl font-bold text-cream mb-3 group-hover:text-cream/80 transition-colors">Sucesiones</h3>
            <p class="text-cream/65 text-sm leading-relaxed mb-5">
              Elaboración de testamentos y asesoría especializada en herencias.
            </p>
            <div class="flex flex-wrap gap-1.5">
              <span class="service-tag">Testamentos</span>
              <span class="service-tag">Sucesión Testamentaria</span>
              <span class="service-tag">Intestamentaria</span>
            </div>
          </div>
        </div>

        <!-- Servicio 3 -->
        <div class="service-card group relative overflow-hidden">
          <span class="absolute -top-4 -right-4 text-[8rem] font-display font-black text-cream/5 leading-none pointer-events-none select-none">03</span>
          <div class="relative z-10">
            <div class="service-card-icon mb-6">
              <i class="fas fa-building"></i>
            </div>
            <h3 class="font-display text-xl font-bold text-cream mb-3 group-hover:text-cream/80 transition-colors">Corporativo</h3>
            <p class="text-cream/65 text-sm leading-relaxed mb-5">
              Formalización de empresas y sociedades mercantiles.
            </p>
            <div class="flex flex-wrap gap-1.5">
              <span class="service-tag">Constitución</span>
              <span class="service-tag">Asambleas</span>
              <span class="service-tag">Fusión/Escisión</span>
            </div>
          </div>
        </div>

        <!-- Servicio 4 -->
        <div class="service-card group relative overflow-hidden">
          <span class="absolute -top-4 -right-4 text-[8rem] font-display font-black text-cream/5 leading-none pointer-events-none select-none">04</span>
          <div class="relative z-10">
            <div class="service-card-icon mb-6">
              <i class="fas fa-handshake"></i>
            </div>
            <h3 class="font-display text-xl font-bold text-cream mb-3 group-hover:text-cream/80 transition-colors">Poderes Notariales</h3>
            <p class="text-cream/65 text-sm leading-relaxed mb-5">
              Otorgamiento de poderes generales y especiales para representación legal.
            </p>
            <div class="flex flex-wrap gap-1.5">
              <span class="service-tag">Poderes generales</span>
              <span class="service-tag">Poderes especiales</span>
              <span class="service-tag">Revocaciones</span>
            </div>
          </div>
        </div>

        <!-- Servicio 5 -->
        <div class="service-card group relative overflow-hidden">
          <span class="absolute -top-4 -right-4 text-[8rem] font-display font-black text-cream/5 leading-none pointer-events-none select-none">05</span>
          <div class="relative z-10">
            <div class="service-card-icon mb-6">
              <i class="fas fa-certificate"></i>
            </div>
            <h3 class="font-display text-xl font-bold text-cream mb-3 group-hover:text-cream/80 transition-colors">Certificaciones</h3>
            <p class="text-cream/65 text-sm leading-relaxed mb-5">
              Certificación de documentos y firmas con validez legal completa.
            </p>
            <div class="flex flex-wrap gap-1.5">
              <span class="service-tag">Firmas</span>
              <span class="service-tag">Copias</span>
              <span class="service-tag">Hechos</span>
            </div>
          </div>
        </div>

        <!-- Servicio 6 -->
        <div class="service-card group relative overflow-hidden">
          <span class="absolute -top-4 -right-4 text-[8rem] font-display font-black text-cream/5 leading-none pointer-events-none select-none">06</span>
          <div class="relative z-10">
            <div class="service-card-icon mb-6">
              <i class="fas fa-balance-scale"></i>
            </div>
            <h3 class="font-display text-xl font-bold text-cream mb-3 group-hover:text-cream/80 transition-colors">Asesoría Legal</h3>
            <p class="text-cream/65 text-sm leading-relaxed mb-5">
              Consultoría especializada en derecho notarial y civil para particulares y empresas.
            </p>
            <div class="flex flex-wrap gap-1.5">
              <span class="service-tag">Consultoría notarial</span>
              <span class="service-tag">Derecho civil</span>
              <span class="service-tag">Corporativo</span>
            </div>
          </div>
        </div>

      </div>

      <!-- CTA Banner -->
      <div class="mt-16 reveal">
        <a href="servicios.html" class="group relative block overflow-hidden rounded-3xl bg-gradient-to-br from-primary-dark via-primary to-primary-dark p-8 md:p-10 shadow-2xl border border-cream/15 hover:border-cream/25 transition-all">
          <div class="floating-shape floating-shape-1 opacity-60" style="width: 200px; height: 200px; top: -60px; right: -40px;"></div>
          <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
              <span class="inline-flex items-center gap-2 glass text-cream/80 text-xs font-semibold tracking-[0.15em] uppercase px-4 py-1.5 rounded-full mb-4">
                <i class="fas fa-gavel"></i> Descubre todo nuestro portafolio
              </span>
              <h3 class="font-display text-3xl md:text-4xl font-bold text-cream">
                ¿Listo para comenzar?
              </h3>
              <p class="text-cream/60 mt-2 max-w-md text-sm md:text-base">
                Explora la lista completa de servicios notariales con toda la información detallada.
              </p>
            </div>
            <div class="flex-shrink-0 glass rounded-2xl px-8 py-4 text-cream font-semibold flex items-center gap-3 group-hover:bg-cream/15 transition-all group-hover:translate-x-1">
              Ver todos los servicios
              <i class="fas fa-arrow-right text-sm"></i>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ── MISIÓN, VISIÓN Y VALORES ── -->
  <section class="py-24 lg:py-32 relative overflow-hidden">
    <!-- Full-bleed background image covering toda la sección -->
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://images.pexels.com/photos/1181722/pexels-photo-1181722.jpeg?auto=compress&cs=tinysrgb&w=1920'); background-position: center 30%; filter: saturate(0.3);"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-primary-dark/75 via-primary/70 to-primary-dark/80"></div>
    <div class="floating-shape floating-shape-3" style="top: 20%; right: 5%;"></div>
    <div class="max-w-7xl mx-auto px-4 relative z-10">
      <div class="text-center mb-16 reveal">
        <span class="text-cream/80 text-sm font-semibold tracking-[0.2em] uppercase mb-4 block">Nuestra Esencia</span>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-cream mb-4">
          Misión, Visión y Valores
        </h2>
        <p class="text-cream/60 text-sm sm:text-base max-w-lg mx-auto leading-relaxed mt-3">Principios que definen nuestra forma de trabajar y relacionarnos con cada cliente que confía en nosotros.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 lg:gap-12 mb-20">
        <!-- Misión -->
        <div class="bg-cream rounded-3xl reveal-left shadow-xl border border-primary/5 hover:shadow-2xl transition-all duration-500 relative overflow-hidden group hover:-translate-y-1.5">
          <!-- Full-width top gradient accent bar -->
          <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-primary-light via-primary to-primary-dark rounded-t-3xl"></div>
          <!-- Número editorial de fondo -->
          <span class="absolute -bottom-4 -right-4 text-[10rem] font-display font-black text-primary/[0.04] leading-none pointer-events-none select-none group-hover:scale-110 group-hover:text-primary/[0.07] transition-all duration-700">01</span>
          <!-- Bottom gradient fade -->
          <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-primary/[0.06] to-transparent pointer-events-none"></div>
          <div class="relative z-10 pt-10 p-8 lg:p-10 lg:pt-14">
            <div class="flex items-center gap-5 mb-6">
              <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-primary-light to-primary flex items-center justify-center text-cream text-3xl shrink-0 shadow-2xl shadow-primary/25 group-hover:scale-110 group-hover:-rotate-6 transition-all duration-500 ring-2 ring-primary-light/20">
                <i class="fas fa-bullseye"></i>
              </div>
              <div>
                <h3 class="font-display text-3xl font-bold text-primary">Misión</h3>
              </div>
            </div>
            <p class="text-base md:text-lg leading-relaxed text-gray-700">
              Ofrecer servicios notariales con la más alta calidad y calidez humana, garantizando la seguridad jurídica de cada acto y construyendo relaciones de confianza duraderas con nuestros clientes.
            </p>
          </div>
        </div>

        <!-- Visión -->
        <div class="bg-cream rounded-3xl reveal-right shadow-xl border border-primary/5 hover:shadow-2xl transition-all duration-500 relative overflow-hidden group hover:-translate-y-1.5">
          <!-- Full-width top gradient accent bar -->
          <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-primary-light via-primary to-primary-dark rounded-t-3xl"></div>
          <!-- Número editorial de fondo -->
          <span class="absolute -bottom-4 -right-4 text-[10rem] font-display font-black text-primary/[0.04] leading-none pointer-events-none select-none group-hover:scale-110 group-hover:text-primary/[0.07] transition-all duration-700">02</span>
          <!-- Bottom gradient fade -->
          <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-primary/[0.06] to-transparent pointer-events-none"></div>
          <div class="relative z-10 pt-10 p-8 lg:p-10 lg:pt-14">
            <div class="flex items-center gap-5 mb-6">
              <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-primary-light to-primary flex items-center justify-center text-cream text-3xl shrink-0 shadow-2xl shadow-primary/25 group-hover:scale-110 group-hover:-rotate-6 transition-all duration-500 ring-2 ring-primary-light/20">
                <i class="fas fa-eye"></i>
              </div>
              <div>
                <h3 class="font-display text-3xl font-bold text-primary">Visión</h3>
              </div>
            </div>
            <p class="text-base md:text-lg leading-relaxed text-gray-700">
              Consolidarnos como la notaría de referencia en Guadalajara, reconocida por nuestra excelencia, innovación y compromiso con la justicia accesible para todos.
            </p>
          </div>
        </div>
      </div>

      <!-- Valores (rediseñado: 3x2 con descripciones) -->
      <div class="reveal mt-20">
        <h3 class="font-display text-2xl lg:text-3xl font-bold text-cream text-center mb-12">Nuestros Valores</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
          <div class="value-card glass-dark rounded-2xl p-7 text-center hover:-translate-y-2 transition-all duration-300 cursor-pointer backdrop-blur-md group">
            <div class="value-icon-wrap-outline mx-auto mb-5 group-hover:scale-110 group-hover:-rotate-3 transition-all duration-500">
              <i class="fas fa-shield-alt"></i>
            </div>
            <span class="block text-lg font-display font-bold text-cream mb-2">Integridad</span>
            <p class="text-cream/65 text-sm leading-relaxed">Actuamos con honestidad y transparencia en cada acción notarial.</p>
          </div>
          <div class="value-card glass-dark rounded-2xl p-7 text-center hover:-translate-y-2 transition-all duration-300 cursor-pointer backdrop-blur-md group">
            <div class="value-icon-wrap-outline mx-auto mb-5 group-hover:scale-110 group-hover:-rotate-3 transition-all duration-500">
              <i class="fas fa-handshake"></i>
            </div>
            <span class="block text-lg font-display font-bold text-cream mb-2">Confianza</span>
            <p class="text-cream/65 text-sm leading-relaxed">Construimos relaciones duraderas basadas en la certeza jurídica.</p>
          </div>
          <div class="value-card glass-dark rounded-2xl p-7 text-center hover:-translate-y-2 transition-all duration-300 cursor-pointer backdrop-blur-md group">
            <div class="value-icon-wrap-outline mx-auto mb-5 group-hover:scale-110 group-hover:-rotate-3 transition-all duration-500">
              <i class="fas fa-star"></i>
            </div>
            <span class="block text-lg font-display font-bold text-cream mb-2">Excelencia</span>
            <p class="text-cream/65 text-sm leading-relaxed">Buscamos la más alta calidad en cada servicio que ofrecemos.</p>
          </div>
          <div class="value-card glass-dark rounded-2xl p-7 text-center hover:-translate-y-2 transition-all duration-300 cursor-pointer backdrop-blur-md group">
            <div class="value-icon-wrap-outline mx-auto mb-5 group-hover:scale-110 group-hover:-rotate-3 transition-all duration-500">
              <i class="fas fa-users"></i>
            </div>
            <span class="block text-lg font-display font-bold text-cream mb-2">Servicio</span>
            <p class="text-cream/65 text-sm leading-relaxed">Ponemos a las personas en el centro de nuestra labor notarial.</p>
          </div>
          <div class="value-card glass-dark rounded-2xl p-7 text-center hover:-translate-y-2 transition-all duration-300 cursor-pointer backdrop-blur-md group">
            <div class="value-icon-wrap-outline mx-auto mb-5 group-hover:scale-110 group-hover:-rotate-3 transition-all duration-500">
              <i class="fas fa-lightbulb"></i>
            </div>
            <span class="block text-lg font-display font-bold text-cream mb-2">Innovación</span>
            <p class="text-cream/65 text-sm leading-relaxed">Incorporamos tecnología para hacer más ágil cada trámite.</p>
          </div>
