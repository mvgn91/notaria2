        <p class="spothub-desc spothub-stagger-2" id="spothubDesc"></p>
        <!-- Tags contextuales -->
        <div class="spothub-tags spothub-stagger-3" id="spothubTags"></div>
        <a id="spothubLink" href="#" target="_blank" rel="noopener noreferrer" class="spothub-link spothub-stagger-4">
          <i class="fas fa-external-link-alt"></i>
          Visitar sitio web
        </a>
        <!-- Navegación entre clientes debajo del link -->
        <div class="spothub-nav spothub-stagger-5">
          <button class="spothub-nav-btn" id="spothubNavPrev" aria-label="Anterior">
            <i class="fas fa-chevron-left"></i>
          </button>
          <span class="spothub-counter" id="spothubCounter"></span>
          <button class="spothub-nav-btn" id="spothubNavNext" aria-label="Siguiente">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>
      </div>
    </div>
  </section>


  <!-- ── TESTIMONIAL MODAL ── -->
  <div class="testimonial-modal" id="testimonialModal">
    <div class="testimonial-modal-overlay" id="testimonialModalOverlay"></div>
    <div class="testimonial-modal-container">
      <!-- Close button -->
      <button class="testimonial-modal-btn testimonial-modal-close" id="testimonialModalClose" aria-label="Cerrar">
        <i class="fas fa-times"></i>
      </button>

      <!-- Navigation arrows -->
      <button class="testimonial-modal-btn testimonial-modal-prev" id="testimonialModalPrev" aria-label="Anterior testimonio">
        <i class="fas fa-chevron-left"></i>
      </button>
      <button class="testimonial-modal-btn testimonial-modal-next" id="testimonialModalNext" aria-label="Siguiente testimonio">
        <i class="fas fa-chevron-right"></i>
      </button>

      <!-- Content -->
      <div class="testimonial-modal-content" id="testimonialModalContent">
        <!-- Stars -->
        <div class="testimonial-modal-stars" id="testimonialModalStars">
          <i class="fas fa-star text-amber-400 text-lg"></i>
          <i class="fas fa-star text-amber-400 text-lg"></i>
          <i class="fas fa-star text-amber-400 text-lg"></i>
          <i class="fas fa-star text-amber-400 text-lg"></i>
          <i class="fas fa-star text-amber-400 text-lg"></i>
        </div>
        <!-- Quote -->
        <div class="testimonial-modal-quote" id="testimonialModalQuote"></div>
        <!-- Divider -->
        <div class="testimonial-modal-divider"></div>
        <!-- Author -->
        <div class="testimonial-modal-author" id="testimonialModalAuthor">
          <div class="testimonial-modal-avatar" id="testimonialModalAvatar"></div>
          <div>
            <h4 class="testimonial-modal-name" id="testimonialModalName"></h4>
            <div class="testimonial-modal-meta">
              <span class="testimonial-modal-source" id="testimonialModalSource"></span>
              <span class="w-1 h-1 rounded-full bg-gray-300 shrink-0"></span>
              <i class="fas fa-check-circle text-emerald-500 text-xs shrink-0"></i>
              <span class="testimonial-modal-verified">Verificada</span>
            </div>
          </div>
        </div>
        <!-- Google link -->
        <div class="testimonial-modal-footer" id="testimonialModalFooter">
          <a id="testimonialModalLink" href="#" target="_blank" class="testimonial-modal-google-link">
            <i class="fab fa-google"></i>
            Ver en Google
          </a>
        </div>
        <!-- Counter -->
        <div class="testimonial-modal-counter" id="testimonialModalCounter">1 / 10</div>
      </div>
    </div>
  </div>

</BaseLayout>
