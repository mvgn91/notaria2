              <a href="https://maps.app.goo.gl/twQxYo9FdYSYLmEw9" target="_blank" class="text-sm text-cream/60 hover:text-cream transition-colors leading-snug">C. Pablo Villaseñor 125, Ladrón de Guevara, 44600 Guadalajara</a>
            </div>
          </div>
        </div>
        <div class="lg:col-span-2">
          <h4 class="font-display font-bold text-cream text-sm mb-4 uppercase tracking-wider">Horarios</h4>
          <div class="flex items-start gap-3">
