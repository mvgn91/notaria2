            <div class="text-sm text-cream/60">
              <p class="font-medium text-cream/80">Lunes a Viernes</p>
              <p>9:00 AM – 5:00 PM</p>
            </div>
          </div>
        </div>
        <div class="lg:col-span-3">
          <h4 class="font-display font-bold text-cream text-sm mb-4 uppercase tracking-wider">Atención Rápida</h4>
          <a href="https://wa.me/523311704104" target="_blank" class="btn-primary px-5 py-3 rounded-xl text-sm flex items-center gap-2 shadow-lg w-fit">
            <i class="fab fa-whatsapp"></i> Contactar por WhatsApp
