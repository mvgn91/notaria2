  <button id="scroll-to-top" class="fixed bottom-6 right-6 z-40 w-12 h-12 bg-primary text-cream rounded-2xl shadow-xl flex items-center justify-center text-lg opacity-0 pointer-events-none transition-all duration-300 hover:bg-primary-dark hover:-translate-y-1 cursor-pointer shadow-primary/20">
    <i class="fas fa-chevron-up"></i>
  </button>

  <script>
    import '/src/js/main.js'
  </script>
</body>
