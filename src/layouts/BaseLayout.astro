            <div class="flex items-start gap-3">
              <div class="w-8 h-8 bg-cream/10 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5"><i class="fas fa-phone-alt text-cream/80 text-xs"></i></div>
